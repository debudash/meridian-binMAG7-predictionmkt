# Railway staging (devnet) — automation worker. Set via Railway Variables / secret store.
# NEVER commit real keypairs. See docs/DEPLOY.md §4 and docs/RAILWAY_STAGING.md.

MODE=calendar

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

MERIDIAN_PROGRAM_ID=9Rb7nxTRRQg2F3qWiDhnQ1dTjDoTvRimcyykLfhwG9r6
MERIDIAN_IDL_PATH=idl/meridian.prod.json

# Railway secret — base58 or JSON array. Name suggestion: AUTOMATION_KEYPAIR
AUTOMATION_KEYPAIR=<RAILWAY_SECRET_AUTOMATION_KEYPAIR>
# M3: separate low-balance key for permissionless settle (signs + pays). Must differ from the
# authority. Fund with ~0.05 devnet SOL. Unset → falls back to the authority with a warning.
SETTLER_KEYPAIR=<RAILWAY_SECRET_SETTLER_KEYPAIR>
# Review dd46769: dedicated Phoenix pauser = each book's seat-manager authority after the PSM handoff
# (ops/devnet-bootstrap.cjs). Pauses books at expiry (cancel/withdraw stay open). Must differ from the
# authority and the settler; ~0.02 devnet SOL for fees. NEVER the upgrade key. Unset → no pausing (warning).
PHOENIX_PAUSER_KEYPAIR=<RAILWAY_SECRET_PHOENIX_PAUSER_KEYPAIR>
PHOENIX_PAUSE_LEAD_SECS=5   # plain integer seconds; = web CLOSE_BUFFER_SECS (Reviewers mr72-73 L4)
PHOENIX_PAUSE_ALERT_SECS=120
# PHOENIX_PAUSE_ALERT_REPEAT_SECS=3600   # optional: standing [pause] ALERT repeat per book / reason (60..86400; Reviewers !78 N-2)
# PAUSE_MEMORY_FILE=/data/pause-memory.json   # optional: only with a persistent volume (Reviewers !78 N-3)

COLLATERAL_MINT=<DEVNET_USDC_MINT_PUBKEY>
STRIKE_SYMBOLS=AAPL
PRIOR_CLOSE_E6=180000000
STRIKE_OFFSETS_E6=-5000000,0,5000000
CREATE_HOUR_ET=8
SETTLE_HOUR_ET=16

# Devnet Pyth reference accounts (shard-1 PDAs are the fresh devnet set, SCHEMA §3.1.1) + feed ids.
# PYTH_FEED_IDS is REQUIRED off-localnet (D-025: settle binds to the market's feed id).
PYTH_PRICE_FEEDS={"AAPL":"D9uk39pqZMcnmtPP9WeC8cREUpKZmyXLga9mSQ79SphW"}
PYTH_FEED_IDS={"AAPL":"49f6b65cb1de6b10eaf75e7c03ca029c306d0357e91b5311b175084a5ad55688"}

# Pyth Hermes (pull-oracle settle price, D-025). Key is REQUIRED since 2026-08-26 — Railway secret only.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_HERMES_API_KEY=<RAILWAY_SECRET_PYTH_HERMES_API_KEY>

# Optional Phoenix market pubkeys per symbol (wiring only; create stubbed)
PHOENIX_MARKETS={"AAPL":"<DEVNET_PHOENIX_MARKET_PUBKEY>"}

SETTLE_POLL_MS=30000
SETTLE_MAX_RETRIES=40
ADMIN_SETTLE_AFTER_RETRIES=20
WORKER_TICK_MS=60000
LOG_LEVEL=info
HEALTH_PORT=8080

# Do NOT set on Railway:
# ANCHOR_FEATURES=localnet-test
# MODE=sim
