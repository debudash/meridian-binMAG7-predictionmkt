{
  "name": "peak6-meridian",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian \u2014 Solana binary Yes/No markets (Peak6). TDD suite owns red until Engineers land program code (D-016).",
  "scripts": {
    "test": "anchor test -- --features localnet-test",
    "test:unit": "mocha -r ts-node/register 'tests/unit/**/*.ts' --timeout 10000 --exit",
    "test:lifecycle": "mocha -r ts-node/register 'tests/{mint,settle,redeem,invariants,pause}.ts' --timeout 120000 --exit",
    "build:localnet": "anchor build -- --features localnet-test",
    "build:prod": "anchor build && node scripts/emit-prod-idl.js && bash scripts/assert-prod-no-fixtures.sh",
    "build:prod-idl": "node scripts/emit-prod-idl.js && bash scripts/assert-idl-sync.sh",
    "assert:prod-fixtures": "bash scripts/assert-prod-no-fixtures.sh",
    "deploy:build": "anchor build",
    "automation:build": "npm install --prefix apps/automation && npm run build --prefix apps/automation",
    "automation:start": "npm run start --prefix apps/automation",
    "automation:sim": "npm run sim-lifecycle --prefix apps/automation",
    "automation:test": "npm test --prefix apps/automation",
    "web:dev": "npm run dev --prefix apps/web",
    "web:build": "npm run build --prefix apps/web",
    "web:test": "npm run test --prefix apps/web",
    "web:typecheck": "npm run typecheck --prefix apps/web",
    "assert:idl-sync": "bash scripts/assert-idl-sync.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.99.0",
    "anchor-bankrun": "^0.5.0",
    "bn.js": "^5.2.1",
    "litesvm": "^1.5.0",
    "solana-bankrun": "^0.3.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
