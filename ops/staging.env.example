# Copy to ops/staging.env (or point STAGING_ENV_FILE at your copy), chmod 600. NEVER commit the real file.
# Paths and public identifiers only; secrets (PYTH_HERMES_API_KEY) come from the process environment.
KEYS_DIR=/path/to/staging-keys            # upgrade-authority.json keeper.json admin.json maker.json trader.json usdc-mint.json
                                          # wallet-b.json settler.json pauser.json + the program keypair (all chmod 600)
PROGRAM_KEYPAIR=$KEYS_DIR/program.json    # program id keypair (deploy only)
UPGRADE_KEY=$KEYS_DIR/upgrade-authority.json
STATE=/path/to/staging-state.json         # bootstrap state (pubkeys, sigs)
REPO=/path/to/peak6-meridian              # git clone (origin = GitLab)
BUILD=/path/to/staging-build              # detached worktree reset to origin/main for the prod build + ops-cli
RPC=https://your-devnet-rpc
EXPECTED_PAUSER_PUB=<pauser pubkey>         # !77 L-3: handoff + pause watcher abort if $PAUSER_KEY's pubkey differs
MERIDIAN_PROGRAM_ID=<program id>
WEB_NODE_MODULES=/path/to/apps/web/node_modules/   # web3 / spl-token / anchor / phoenix-sdk for the .cjs scripts
WEB_SRC=/path/to/prepared/apps/web        # optional: e2e Buy Yes/No (needs node_modules); unset → skipped
WEB_VARS=/path/to/web.vars.json           # optional: managed web env (cluster pinned to devnet)
WEB_URL=https://your-staging-web          # optional: /markets fixture check
DEBU_WALLET=<phantom devnet pubkey>       # optional: funded with SOL + mUSDC
# Optional overrides: SETTLER_KEY PAUSER_KEY WALLET_B_KEY MIN_SOL WAIT_HOURS SHORT_MIN SHORT_SETUP_SECS START_FILE
#   PULL_SETTLE_AFTER SETTLE_AFTER PAUSE_LOG PYTH_PRICE_RPC BUILD_LOG AUTO (ops-cli dir, default $BUILD/apps/automation)
#   ADMIN_PRICE_FILE (operator admin_settle price, default $OPS_DIR/ADMIN_PRICE_20M) OPERATOR_PRICE_WAIT_HOURS (24)
#   ADMIN_PRICE_MAX_SKEW_SECS (60 = on-chain window; up to 300 as a logged override)
#   PHOENIX_PAUSE_ALERT_REPEAT_SECS (3600) PAUSE_MEMORY_FILE (default <state>-pause-memory.json)
