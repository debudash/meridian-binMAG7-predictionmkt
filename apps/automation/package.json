{
  "name": "@peak6/meridian-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian Railway Node automation \u2014 calendar (prod/devnet) + localnet-only sim lifecycle (D-017)",
  "main": "dist/worker.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker.js",
    "sim-lifecycle": "node dist/sim-lifecycle.js",
    "test": "TS_NODE_PROJECT=tsconfig.test.json mocha -r ts-node/register 'test/**/*.test.ts' --timeout 15000 --exit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:railway": "rm -rf dist && tsc -p tsconfig.prod.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@coral-xyz/anchor": "0.31.1",
    "@pythnetwork/pyth-solana-receiver": "0.16.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.7.4",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "jito-ts": {
      "@solana/web3.js": "$@solana/web3.js"
    }
  }
}
