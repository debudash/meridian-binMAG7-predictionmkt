# Meridian automation — copy to .env locally; set via Railway Variables in staging/prod.
# NEVER commit real keypairs or tokens.

# calendar = Railway/prod/devnet worker (default). sim = localnet-only lifecycle (use sim-lifecycle entry).
MODE=calendar

SOLANA_RPC_URL=https://api.devnet.solana.com
# localnet | devnet | mainnet-beta
SOLANA_CLUSTER=devnet

MERIDIAN_PROGRAM_ID=9Rb7nxTRRQg2F3qWiDhnQ1dTjDoTvRimcyykLfhwG9r6
# Prod/Railway: packaged path under apps/automation (baked by emit-prod-idl). Monorepo root ../../idl/ also resolves.
MERIDIAN_IDL_PATH=idl/meridian.prod.json

# JSON array path or base58 secret — Railway secret only. Never commit.
AUTOMATION_KEYPAIR=

COLLATERAL_MINT=
# Comma-separated equity symbols (space-padded to 8 bytes internally). Default = SPEC §1 MAG7.
STRIKE_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA
# DLV-118 (SPEC §1/§3.3): calendar mode creates each trading day's markets at the 9:30 ET open (window 09:30–16:00 ET,
# weekends / NYSE holidays skipped) with expiry = THAT day's 16:00 ET close. Never after the close (no next-day roll).
# Strike = fresh reference rounded to STRIKE_STEP_E6 (default $5 at/above $100, else $1) + STRIKE_OFFSETS_E6.
# Reference order: Hermes latest (if PYTH_HERMES_API_KEY is entitled; equities are 403 today, DLV-106) → the sponsored
# PYTH_PRICE_FEEDS account if ≤ STRIKE_REF_MAX_AGE_SECS old → operator prices for TODAY → else skip + ALERT (retries).
STRIKE_OFFSETS_E6=-5000000,0,5000000
# Positive integer micro-USD if set (validated at start, DLV-119).
STRIKE_STEP_E6=
STRIKE_REF_MAX_AGE_SECS=300
# Operator-sourced prices: JSON {"dateKey":"YYYY-MM-DD","source":"<where from>","pricesE6":{"AAPL":"227310000",...}}
# inline or as a file read at use time. STRIKE = reference at the open; CLOSE = admin_settle price at the close.
# Staging: set them with `node ops/operator-prices.cjs strike|close --source … AAPL=… (all 7)` (validates, sets the Railway
# variable, redeploys automation — inline env is read at start). Operator strikes must be within ±20% of the last
# known Pyth price when one exists (DLV-119).
OPERATOR_STRIKE_PRICES=
OPERATOR_STRIKE_PRICES_FILE=
OPERATOR_CLOSE_PRICES=
OPERATOR_CLOSE_PRICES_FILE=
# Sim mode (localnet) only: prior-close placeholder (e6). Calendar mode no longer uses it (DLV-118).
PRIOR_CLOSE_E6=180000000
# Deprecated (DLV-118): calendar create now runs at the 9:30 ET open; ignored by the worker.
CREATE_HOUR_ET=8
# Settle gate hour ET (inclusive); product requires >= 16:00 ET. Calendar mode enforces this client-side too.
SETTLE_HOUR_ET=16

# Pyth price account pubkeys keyed by symbol (JSON object). Required for create + settle.
# Example: {"AAPL":"<pubkey>"}
PYTH_PRICE_FEEDS={}
# 32-byte Pyth feed ids as hex (64 hex chars) per symbol. REQUIRED off-localnet (D-025); localnet default zeros.
PYTH_FEED_IDS={}
# Hermes (pull-oracle settle price, D-025). API key required since 2026-08-26 (Bearer). Secret — never commit.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_HERMES_API_KEY=

# DLV-119 L-8: IGNORED for the daily markets (a fixed book belongs to an older market's Yes mint) — ALERT if set.
# Keep empty until the worker creates a book per market. Phoenix market *create* in the worker is TODO.
PHOENIX_MARKETS={}

# Settle retry loop
SETTLE_POLL_MS=30000
SETTLE_MAX_RETRIES=40
# After this many settle failures past expiry+admin_settle_delay, try admin_settle (authority only).
ADMIN_SETTLE_AFTER_RETRIES=20
# DLV-118: off-localnet admin_settle uses OPERATOR_CLOSE_PRICES(_FILE) bound to the market's ET day (outcome = price ≥ strike).
# The old static price below is LOCALNET-ONLY (sim/dev); ignored off-localnet (no unsourced price, M3).
ADMIN_SETTLE_PRICE_E6=
ADMIN_SETTLE_OUTCOME_YES=

# Worker loop
WORKER_TICK_MS=60000
LOG_LEVEL=info
# Optional HTTP health for Railway healthcheckPath=/health (default 8080)
HEALTH_PORT=8080

# --- localnet / sim-lifecycle only (NEVER set on Railway) ---
# MERIDIAN_IDL_PATH=../../idl/meridian.json
# SOLANA_CLUSTER=localnet
# SOLANA_RPC_URL=http://127.0.0.1:8899
# Do NOT set ANCHOR_FEATURES=localnet-test on Railway.
