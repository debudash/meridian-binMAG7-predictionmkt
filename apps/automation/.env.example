# Meridian automation — copy to .env locally; set via Railway Variables in staging/prod.
# NEVER commit real keypairs or tokens.

# calendar = Railway/prod/devnet worker (default). sim = localnet-only lifecycle (use sim-lifecycle entry).
MODE=calendar

SOLANA_RPC_URL=https://api.devnet.solana.com
# localnet | devnet | mainnet-beta
SOLANA_CLUSTER=devnet

MERIDIAN_PROGRAM_ID=GwTvo6yNrGc8FS8cRYi1wbqcynVyWgkQssZ2vyYnxxo2
# Prod/Railway MUST point at meridian.prod.json (relative to repo root or absolute).
MERIDIAN_IDL_PATH=../../idl/meridian.prod.json

# JSON array path or base58 secret — Railway secret only. Never commit.
AUTOMATION_KEYPAIR=

COLLATERAL_MINT=
# Comma-separated equity symbols (space-padded to 8 bytes internally), e.g. AAPL,MSFT
STRIKE_SYMBOLS=AAPL
# Prior-close placeholder (e6). Extension point: replace with real prior-close feed.
PRIOR_CLOSE_E6=180000000
# Strike offsets from prior close in e6 (comma-separated), e.g. -5000000,0,5000000 => ±$5
STRIKE_OFFSETS_E6=-5000000,0,5000000
# Hour (0-23) America/New_York for morning create; default 8
CREATE_HOUR_ET=8
# Settle gate hour ET (inclusive); product requires >= 16:00 ET. Calendar mode enforces this client-side too.
SETTLE_HOUR_ET=16

# Pyth price account pubkeys keyed by symbol (JSON object). Required for create + settle.
# Example: {"AAPL":"<pubkey>"}
PYTH_PRICE_FEEDS={}
# Optional 32-byte feed ids as hex (64 hex chars) per symbol. Default: zeros.
PYTH_FEED_IDS={}

# Optional Phoenix market pubkeys per symbol. If set, automation calls set_phoenix_market after create.
# Phoenix market *create* is stubbed (TODO) — wiring only.
PHOENIX_MARKETS={}

# Settle retry loop
SETTLE_POLL_MS=30000
SETTLE_MAX_RETRIES=40
# After this many settle failures past expiry+admin_settle_delay, try admin_settle (authority only).
ADMIN_SETTLE_AFTER_RETRIES=20
# Fallback admin outcome if forced (dev/ops only). Prefer real Pyth settle.
ADMIN_SETTLE_PRICE_E6=
ADMIN_SETTLE_OUTCOME_YES=

# Worker loop
WORKER_TICK_MS=60000
LOG_LEVEL=info

# --- localnet / sim-lifecycle only (NEVER set on Railway) ---
# MERIDIAN_IDL_PATH=../../idl/meridian.json
# SOLANA_CLUSTER=localnet
# SOLANA_RPC_URL=http://127.0.0.1:8899
# Do NOT set ANCHOR_FEATURES=localnet-test on Railway.
