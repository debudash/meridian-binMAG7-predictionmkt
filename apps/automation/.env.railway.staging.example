# Railway staging (devnet) — automation worker. Set via Railway Variables / secret store.
# NEVER commit real keypairs. See docs/DEPLOY.md §4 and docs/RAILWAY_STAGING.md.

MODE=calendar

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

MERIDIAN_PROGRAM_ID=9Rb7nxTRRQg2F3qWiDhnQ1dTjDoTvRimcyykLfhwG9r6
MERIDIAN_IDL_PATH=idl/meridian.prod.json

# Railway secret — base58 or JSON array. Name suggestion: AUTOMATION_KEYPAIR
AUTOMATION_KEYPAIR=<RAILWAY_SECRET_AUTOMATION_KEYPAIR>

COLLATERAL_MINT=<DEVNET_USDC_MINT_PUBKEY>
STRIKE_SYMBOLS=AAPL
PRIOR_CLOSE_E6=180000000
STRIKE_OFFSETS_E6=-5000000,0,5000000
CREATE_HOUR_ET=8
SETTLE_HOUR_ET=16

# Devnet Pyth price accounts + optional feed ids (JSON objects)
PYTH_PRICE_FEEDS={"AAPL":"<DEVNET_PYTH_PRICE_ACCOUNT>"}
PYTH_FEED_IDS={}

# Optional Phoenix market pubkeys per symbol (wiring only; create stubbed)
PHOENIX_MARKETS={"AAPL":"<DEVNET_PHOENIX_MARKET_PUBKEY>"}

SETTLE_POLL_MS=30000
SETTLE_MAX_RETRIES=40
ADMIN_SETTLE_AFTER_RETRIES=20
WORKER_TICK_MS=60000
LOG_LEVEL=info
HEALTH_PORT=8080

# Do NOT set on Railway:
# ANCHOR_FEATURES=localnet-test
# MODE=sim
