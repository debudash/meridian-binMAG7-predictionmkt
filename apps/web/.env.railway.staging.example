# Railway staging (devnet) — web service. Copy values into Railway Variables.
# NEVER put keypairs here. See docs/DEPLOY.md §5.2.

# --- Solana (public) ---
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_MERIDIAN_PROGRAM_ID=3X3ETGZYNcZ5BMMxcEuDhXxfisAmWzgqvdnhivbK91Hj
NEXT_PUBLIC_USDC_MINT=<DEVNET_USDC_MINT_PUBKEY>
NEXT_PUBLIC_EXPLORER_URL=https://explorer.solana.com

# --- Phoenix (D-015 Yes/USDC) ---
# false → always not-configured; true or unset+market pubkey → live place path
NEXT_PUBLIC_PHOENIX_ENABLED=true
NEXT_PUBLIC_PHOENIX_PROGRAM_ID=PhoeNiXZ8ByJGLkxNfZRnkUfjvmuYqLR89jjFHGqdXY
# Per-market phoenix pubkeys come from StrikeMarket.phoenix_market (indexer/RPC).
# Optional override map for ops docs only (not read by web unless you wire it):
# PHOENIX_MARKET_AAPL=<DEVNET_PHOENIX_MARKET_PUBKEY>

# --- Indexer (optional HTTP; else RPC getProgramAccounts / fixtures) ---
NEXT_PUBLIC_INDEXER_URL=

# --- Pyth (display; settlement is on-chain) ---
# NEXT_PUBLIC_PYTH_FEED_AAPL=<DEVNET_PYTH_PRICE_ACCOUNT>
