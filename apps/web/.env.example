# Public browser env (Railway web service). Never put keypairs here.
# See docs/DEPLOY.md §5.2 · staging template: .env.railway.staging.example

NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_MERIDIAN_PROGRAM_ID=3X3ETGZYNcZ5BMMxcEuDhXxfisAmWzgqvdnhivbK91Hj
NEXT_PUBLIC_USDC_MINT=
# Optional — indexer / Phoenix / explorer
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_PHOENIX_ENABLED=
NEXT_PUBLIC_PHOENIX_PROGRAM_ID=PhoeNiXZ8ByJGLkxNfZRnkUfjvmuYqLR89jjFHGqdXY
NEXT_PUBLIC_EXPLORER_URL=https://explorer.solana.com
# LOCALNET ONLY — dev signer without a browser extension (see README "Localnet dev wallet").
# Ignored unless NEXT_PUBLIC_SOLANA_CLUSTER=localnet and RPC is 127.0.0.1/localhost. Never set on devnet/mainnet.
# NEXT_PUBLIC_LOCALNET_DEV_WALLET=true
# LOCALNET_DEV_WALLET_KEYPAIR=/abs/path/outside/repo/localnet-dev-wallet.json
